{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zexy2/izmir-mcp",
  "title": "İzmir MCP",
  "description": "Read-only MCP server for İzmir open city data: transit, buses, ferries, water, air, pharmacies.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/zexy2/izmirmcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "izmir-mcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/zexy2/izmir-mcp:0.1.0",
      "runtimeHint": "docker",
      "packageArguments": [
        {
          "type": "positional",
          "value": "izmir-mcp"
        },
        {
          "type": "positional",
          "value": "stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "IZMIR_MCP_SKIP_GTFS_BUILD",
          "description": "1 skips the GTFS timetable build at container start (faster stdio start).",
          "default": "1"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
