{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.batu1-1an/izmir-mcp",
  "description": "Read-only MCP server for İzmir open city data: CKAN catalog, nearby services, water, air quality, transit timetables and EShot buses.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "izmir-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "python -m app.stdio"
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/batu1-1an/izmir-mcp:0.1.0",
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8000/mcp/"
      }
    }
  ]
}
