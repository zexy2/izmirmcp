# Sunucu
IZMIR_MCP_HOST=127.0.0.1
IZMIR_MCP_PORT=8000

# Ağ ve limitler
IZMIR_MCP_REQUEST_TIMEOUT_SECONDS=15
IZMIR_MCP_REQUEST_ATTEMPTS=2
# Tek bir upstream isteğinin toplam süresi (yeniden denemeler dahil); 0 = kapalı
IZMIR_MCP_HTTP_TOTAL_DEADLINE_SECONDS=0
IZMIR_MCP_RESPONSE_MAX_BYTES=2000000
IZMIR_MCP_DEFAULT_LIMIT=10
IZMIR_MCP_MAX_LIMIT=50
IZMIR_MCP_MAX_RADIUS_M=5000
# Upstream başına istek bütçesi (token bucket)
IZMIR_MCP_SOURCE_RATE_CAPACITY=10
IZMIR_MCP_SOURCE_RATE_REFILL_PER_SECOND=2.0
IZMIR_MCP_SOURCE_RATE_MAX_WAIT_SECONDS=2.0

# Kaynak tabanları (varsayılanlar doğrulanmış resmî uçlardır)
IZMIR_MCP_CKAN_BASE_URL=https://acikveri.bizizmir.com/api/3/action
IZMIR_MCP_OPENAPI_BASE_URL=https://openapi.izmir.bel.tr/api
IZMIR_MCP_IZSU_DAMS_CSV_URL=https://openfiles.izmir.bel.tr/309436/docs/izsu-baraj-doluluk-oranlari.csv
IZMIR_MCP_IZSU_API_BASE_URL=https://izsu.gov.tr/api/proxy
IZMIR_MCP_IZSU_PAST_CACHE_TTL_SECONDS=604800
IZMIR_MCP_IZTEK_POSITIONS_CACHE_TTL_SECONDS=15
IZMIR_MCP_CBS_MAX_PAGES=10
IZMIR_MCP_CBS_CACHE_TTL_SECONDS=86400
IZMIR_MCP_EVENTS_CACHE_TTL_SECONDS=3600
IZMIR_MCP_HAL_CACHE_TTL_SECONDS=604800
IZMIR_MCP_PHARMACIES_ALL_CACHE_TTL_SECONDS=86400

# ESHOT (doğrulanmış uçlar)
IZMIR_MCP_ESHOT_STOPS_RESOURCE_ID=0c791266-a2e4-4f14-82b8-9a9b102fbf94
IZMIR_MCP_ESHOT_ROUTES_RESOURCE_ID=bd6c84f8-49ba-4cf4-81f8-81a0fbb5caa3
IZMIR_MCP_ESHOT_CACHE_TTL_SECONDS=86400
IZMIR_MCP_ESHOT_STALE_IF_ERROR_SECONDS=604800
IZMIR_MCP_IZTEK_BASE_URL=https://openapi.izmir.bel.tr/api/iztek
IZMIR_MCP_IZTEK_CACHE_TTL_SECONDS=20
IZMIR_MCP_IZTEK_STALE_IF_ERROR_SECONDS=120
IZMIR_MCP_IZTEK_POSITIONS_STALE_IF_ERROR_SECONDS=90
IZMIR_MCP_OPENAPI_STALE_IF_ERROR_SECONDS=3600
IZMIR_MCP_OPENAPI_TIMEOUT_SECONDS=10
IZMIR_MCP_LIVE_VEHICLE_TIMEOUT_SECONDS=5
IZMIR_MCP_IZTEK_MIN_REQUEST_INTERVAL_SECONDS=0.5
IZMIR_MCP_ESHOT_GTFS_URL=https://www.eshot.gov.tr/gtfs/bus-eshot-gtfs.zip
IZMIR_MCP_ESHOT_GTFS_MAX_BYTES=67108864
IZMIR_MCP_ESHOT_GTFS_MEMBER_MAX_BYTES=8388608
IZMIR_MCP_ESHOT_GTFS_CACHE_TTL_SECONDS=86400
IZMIR_MCP_ESHOT_GTFS_STALE_IF_ERROR_SECONDS=604800
IZMIR_MCP_ESHOT_GTFS_STOP_TIMES_MAX_BYTES=134217728
IZMIR_MCP_ESHOT_GTFS_MAX_ROWS=2500000

# Yerel veritabanları (git dışında tutulur)
IZMIR_MCP_DATABASE_PATH=.data/izmir_mcp.sqlite3
IZMIR_MCP_GTFS_DATABASE_PATH=.data/izmir_mcp_gtfs.sqlite3

# Şehir katmanları (doğrulanmış CKAN DataStore kaynakları)
IZMIR_MCP_ESHOT_NOTICES_CSV_URL=https://openfiles.izmir.bel.tr/211488/docs/eshot-otobus-hat-duyurulari.csv
IZMIR_MCP_ESHOT_NOTICES_CACHE_TTL_SECONDS=1800
IZMIR_MCP_CITY_LAYER_CACHE_TTL_SECONDS=86400
IZMIR_MCP_CITY_LAYER_STALE_IF_ERROR_SECONDS=604800
IZMIR_MCP_TRAFFIC_STALE_AFTER_HOURS=72

# Önbellek ve dayanıklılık
IZMIR_MCP_SOURCE_CACHE_MAX_ENTRIES=512
# Olay döngüsü 5-3600 sn yanıt vermezse süreci yeniden başlatır; 0 = kapalı
IZMIR_MCP_EVENT_LOOP_WATCHDOG_SECONDS=0

# Sınırlı SQL (izmir_datastore_query); yalnızca listelenen kaynak id'leri
IZMIR_MCP_CKAN_SQL_ALLOWED_RESOURCE_IDS=
IZMIR_MCP_CKAN_SQL_MAX_ROWS=50000
IZMIR_MCP_CKAN_SQL_MAX_BYTES=20971520
IZMIR_MCP_CKAN_SQL_PAGE_SIZE=5000
IZMIR_MCP_CKAN_SQL_SNAPSHOT_TTL_SECONDS=900
IZMIR_MCP_CKAN_SQL_LOAD_TIMEOUT_SECONDS=30
IZMIR_MCP_CKAN_SQL_QUERY_TIMEOUT_SECONDS=0.5

# HTTP yüzeyi sertleştirmesi (varsayılanlar yerel kullanım için güvenli)
IZMIR_MCP_CLIENT_MAX_BODY_BYTES=1000000
IZMIR_MCP_CLIENT_RATE_LIMIT_CAPACITY=60
IZMIR_MCP_CLIENT_RATE_LIMIT_REFILL_PER_SECOND=1.0
IZMIR_MCP_CLIENT_RATE_LIMIT_MAX_CLIENTS=10000
IZMIR_MCP_CLIENT_MAX_CONCURRENT_REQUESTS=32
IZMIR_MCP_ACCESS_LOG_ENABLED=true
# Virgülle ayrılmış; boş bırakılırsa kimlik doğrulama kapalıdır
IZMIR_MCP_API_KEYS=
# true: anahtar yoksa 0.0.0.0 gibi genel bir adrese bağlanmayı reddeder
IZMIR_MCP_REQUIRE_AUTH=false
# Anahtar başına günlük çağrı kotası; 0 = sınırsız
IZMIR_MCP_API_KEY_DAILY_QUOTA=0
# Virgülle ayrılmış Host başlıkları (DNS rebinding koruması). Boşsa yalnızca
# uyarı verilir; Railway vb. dağıtımlarda genel alan adınızı buraya ekleyin.
IZMIR_MCP_ALLOWED_HOSTS=
# Virgülle ayrılmış HTTPS origin'ler; boşsa tarayıcı istekleri reddedilir
IZMIR_MCP_CORS_ALLOWED_ORIGINS=
